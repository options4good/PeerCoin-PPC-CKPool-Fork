%.A: %.asm
	yasm -f x64 -f elf64 -X gnu -g dwarf2 -D LINUX -o $@ $<

install-exec-hook:
	setcap CAP_NET_BIND_SERVICE=+eip $(bindir)/ckpool
	$(LN_S) -f ckpool $(DESTDIR)$(bindir)/ckproxy

uninstall-local:
	rm -f $(bindir)/ckproxy

